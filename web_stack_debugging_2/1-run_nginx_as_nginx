#!/usr/bin/env bash
# Runs Nginx as the nginx user, listening on port 8080
pkill apache2
pkill -x nginx
sed -i 's/^\s*#\?\s*user .*;/user nginx;/' /etc/nginx/nginx.conf
sed -i '/^\s*listen/s/\b80\b/8080/g' /etc/nginx/nginx.conf /etc/nginx/sites-available/* /etc/nginx/conf.d/* 2> /dev/null
chmod 644 /etc/nginx/nginx.conf
touch /run/nginx.pid
chown -R nginx:nginx /run/nginx.pid /var/log/nginx /var/lib/nginx
sleep 1
runuser -u nginx -- /usr/sbin/nginx
