#!/usr/bin/env bash
# Installs Nginx and sets up a 301 redirect for /redirect_me
apt-get update
apt-get install -y nginx
echo "Holberton School for the win!" > /var/www/html/index.html
echo "Holberton School for the win!" > /var/www/html/index.nginx-debian.html
if ! grep -q "redirect_me" /etc/nginx/sites-available/default; then
    sed -i 's|server_name _;|server_name _;\n\trewrite ^/redirect_me https://www.youtube.com/watch?v=QH2-TGUlwu4 permanent;|' /etc/nginx/sites-available/default
fi
service nginx restart
